<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Generated by scripts/scheduler/install_scheduler.sh — do not edit the installed copy;
     re-run the installer to regenerate. __PLACEHOLDERS__ are substituted there. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cnequity.stale</string>

  <!-- launchd hands an agent the system default of 256 descriptors, and
       compacting a dataset with thousands of day partitions exhausts that:
       `trading_status` failed twice on 2026-09-18 with "Too many open files
       (os error 24)". An interactive shell never sees it, which is why this
       only ever fails on a schedule. -->
  <key>SoftResourceLimits</key>
  <dict>
    <key>NumberOfFiles</key>
    <integer>8192</integer>
  </dict>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO_ROOT__/scripts/scheduler/stale_pipeline.sh</string>
  </array>

  <!-- Wake at :37 every hour; the pipeline runs once per session, after
       [job.stale] run_at in Beijing time and after that session's daily run,
       retrying only the snapshot datasets it missed (scripts/scheduler/scheduler_gate.py). -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Minute</key>
    <integer>37</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <key>EnvironmentVariables</key>
  <dict>
    <key>CNE_GROUPS</key>
    <string>__GROUPS__</string>
    <key>CNE_SCHEDULED</key>
    <string>1</string>
    <key>CNE_SOURCE_VANTAGE</key>
    <string>__SOURCE_VANTAGE__</string>
  </dict>

  <key>WorkingDirectory</key>
  <string>__REPO_ROOT__</string>

  <key>StandardOutPath</key>
  <string>__REPO_ROOT__/data/cnequity/logs/launchd-stale.out.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO_ROOT__/data/cnequity/logs/launchd-stale.err.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
