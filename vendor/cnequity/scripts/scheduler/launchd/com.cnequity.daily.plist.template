<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Generated by scripts/scheduler/install_scheduler.sh — do not edit the installed copy;
     re-run the installer to regenerate. __PLACEHOLDERS__ are substituted there. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cnequity.daily</string>

  <!-- launchd hands an agent the system default of 256 descriptors, and
       compacting a dataset with thousands of day partitions exhausts that:
       `trading_status` failed twice on 2026-09-18 with "Too many open files
       (os error 24)". An interactive shell never sees it, which is why this
       only ever fails on a schedule. -->
  <key>SoftResourceLimits</key>
  <dict>
    <key>NumberOfFiles</key>
    <integer>8192</integer>
  </dict>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO_ROOT__/scripts/scheduler/daily_pipeline.sh</string>
  </array>

  <!-- Wake at :07 every hour. The pipeline itself decides whether this is
       the run (scripts/scheduler/scheduler_gate.py): once per session, after
       [job.daily] run_at in *Beijing* time. So no host timezone or daylight-
       saving arithmetic lives here, and a Mac asleep at run_at runs on waking. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Minute</key>
    <integer>7</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <!-- Run every configured daily group.  Source-specific soft failures are
       reported by the pipeline, but a core-only plist silently left the
       capital/signals/fundamentals/macro/research groups behind. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>CNE_GROUPS</key>
    <string>__GROUPS__</string>
    <!-- The delayed stale pass has its own agent below.  Keep this explicit so
         an upgraded install cannot accidentally reintroduce a 30-minute wait. -->
    <key>CNE_STALE_RETRY</key>
    <string>0</string>
    <!-- Hourly wake-ups are gated; a manual scripts/scheduler/daily_pipeline.sh is not. -->
    <key>CNE_SCHEDULED</key>
    <string>1</string>
    <key>CNE_SOURCE_VANTAGE</key>
    <string>__SOURCE_VANTAGE__</string>
  </dict>

  <key>WorkingDirectory</key>
  <string>__REPO_ROOT__</string>

  <key>StandardOutPath</key>
  <string>__REPO_ROOT__/data/cnequity/logs/launchd.out.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO_ROOT__/data/cnequity/logs/launchd.err.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
